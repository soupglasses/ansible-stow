amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

// ansible-test only runs inside an ansible_collections/<namespace>/<name>
// directory, so each step checks out the staged files into one.
local function inCollection(command: String): String = """
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    git checkout-index --all --prefix="$tmp/ansible_collections/soupglasses/stow/"
    cd "$tmp/ansible_collections/soupglasses/stow"
    \(command)
    """

// Test only with the Python that mise pins, not every python3.X on PATH.
local python = #"--python "$(python3 -c 'import sys; print(*sys.version_info[:2], sep=".")')""#

steps {
    ["sanity"] {
        check = inCollection("ansible-test sanity --color --venv \(python)")
    }
    // Wait for sanity to fill ansible-test's shared download cache, which
    // concurrent first runs corrupt.
    ["units"] {
        depends = List("sanity")
        check = inCollection("ansible-test units --color --venv \(python)")
    }
    ["integration"] {
        depends = List("sanity")
        check = inCollection("ansible-test integration stow --color --venv")
    }
    ["build"] {
        check = inCollection("ansible-galaxy collection build --output-path \"$tmp/dist\"")
    }
}
